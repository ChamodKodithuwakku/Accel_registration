# Google Apps Script Web App URL (must end with /exec)
# Deploy > New deployment > Web app > Execute as: Me > Who has access: Anyone
VITE_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec"

# Optional: override the dashboard login (defaults to accel / 1234567).
# These are bundled into the client build, so they are a speed bump, not security.
VITE_DASHBOARD_USER="accel"
VITE_DASHBOARD_PASSWORD="1234567"
